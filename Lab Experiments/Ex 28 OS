#include <stdio.h>
#include <string.h>

#define MAX 1024

int main(int argc, char *argv[])
{
    if (argc != 3)
    {
        printf("Usage: %s <pattern> <filename>\n", argv[0]);
        return 1;
    }

    FILE *fp = fopen(argv[2], "r");

    if (fp == NULL)
    {
        perror("File error");
        return 1;
    }

    char line[MAX];

    while (fgets(line, sizeof(line), fp))
    {
        if (strstr(line, argv[1]) != NULL)
            printf("%s", line);
    }

    fclose(fp);

    return 0;
}