#include <stdio.h>
#include <dirent.h>

int main()
{
    DIR *directory;
    struct dirent *entry;

    directory = opendir(".");

    if (directory == NULL)
    {
        perror("opendir");
        return 1;
    }

    printf("Files and directories:\n");

    while ((entry = readdir(directory)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(directory);

    return 0;
}