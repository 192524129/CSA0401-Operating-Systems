#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n;
    int head;
    int totalSeekTime = 0;

    printf("Enter number of disk requests: ");
    scanf("%d", &n);

    int request[n];

    printf("Enter disk request queue:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nHead Movement:\n");
    printf("%d", head);

    for (int i = 0; i < n; i++)
    {
        totalSeekTime += abs(head - request[i]);

        head = request[i];

        printf(" -> %d", head);
    }

    printf("\n\nTotal Seek Time = %d\n",
           totalSeekTime);

    printf("Average Seek Time = %.2f\n",
           (float)totalSeekTime / n);

    return 0;
}